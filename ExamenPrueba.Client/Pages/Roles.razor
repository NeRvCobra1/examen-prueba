@page "/roles"

@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@using Microsoft.JSInterop

@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Roles</PageTitle>
<h1>Roles</h1>

@if (needsLogin)
{
    <p role="alert">La sesión terminó. <a href="Account/Login?returnUrl=%2Froles">Inicia sesión</a>.</p>
}
else if (accessDenied)
{
    <p role="alert">No tienes el permiso roles.read.</p>
}
else if (isLoading)
{
    <p>Cargando roles...</p>
}
else
{
    @if (message is not null)
    {
        <p role="status">@message</p>
    }

    <form @onsubmit="SearchAsync" @onsubmit:preventDefault class="row g-2 mb-3">
        <div class="col-sm-6">
            <label for="role-search" class="form-label">Buscar por nombre</label>
            <input id="role-search" class="form-control" @bind="searchInput" maxlength="64" />
        </div>
        <div class="col-sm-auto align-self-end">
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </div>
    </form>

    @if (Can("roles.create"))
    {
        <button type="button" class="btn btn-primary mb-3" @onclick="ToggleCreate">Crear rol</button>
        @if (showCreate)
        {
            <form @onsubmit="CreateAsync" @onsubmit:preventDefault class="card card-body mb-3">
                <h2 class="h5">Nuevo rol</h2>
                <label for="create-role-name" class="form-label">Nombre</label>
                <input id="create-role-name" class="form-control mb-2" @bind="createName" required maxlength="64" />
                <button type="submit" class="btn btn-primary" disabled="@isSaving">Guardar</button>
            </form>
        }
    }

    <p>Total: @totalCount</p>
    <table class="table table-striped">
        <thead>
            <tr><th>Nombre</th><th>Tipo</th><th>Usuarios</th><th>Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var role in roles)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>@(role.IsProtected ? "Protegido" : "Personalizado")</td>
                    <td>@role.UserCount</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ShowDetailsAsync(role.Id)">Detalle</button>
                        @if (!role.IsProtected && Can("roles.update"))
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => BeginEdit(role)">Editar</button>
                        }
                        @if (!role.IsProtected && Can("roles.delete"))
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(role)">Eliminar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex align-items-center gap-2 mb-3">
        <button type="button" class="btn btn-outline-secondary" disabled="@(page <= 1)" @onclick="PreviousPageAsync">Anterior</button>
        <span>Página @(page) de @PageCount</span>
        <button type="button" class="btn btn-outline-secondary" disabled="@(page >= PageCount)" @onclick="NextPageAsync">Siguiente</button>
    </div>

    @if (selectedRole is not null)
    {
        <section class="card card-body mb-3">
            <h2 class="h5">Detalle del rol</h2>
            <p>Id: @selectedRole.Id</p>
            <p>Nombre: @selectedRole.Name</p>
            <p>Tipo: @(selectedRole.IsProtected ? "Protegido" : "Personalizado")</p>
            <p>Usuarios asignados: @selectedRole.UserCount</p>

            @if (CanReadRolePermissions)
            {
                <h3 class="h6">Matriz Rol–Permiso</h3>
                @if (rolePermissions is null)
                {
                    <p>Cargando permisos del rol...</p>
                }
                else
                {
                    @if (CanManageRolePermissions && !isCurrentAdmin)
                    {
                        <p class="text-warning">Las modificaciones requieren además un operador Admin vigente.</p>
                    }
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr><th>Asignado</th><th>Código</th><th>Nombre</th><th>Tipo</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var permission in rolePermissions.Permissions)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@permission.Assigned"
                                                   disabled="@(isSaving || permission.Locked || !CanManageRolePermissions || !isCurrentAdmin)"
                                                   @onchange="() => ChangePermissionAsync(permission)" />
                                        </td>
                                        <td><code>@permission.Code</code></td>
                                        <td>@permission.Name@(permission.Locked ? " (protegido)" : "")</td>
                                        <td>@(permission.IsSystem ? "Sistema" : "Personalizado")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <p>La matriz requiere conjuntamente roles.read y permissions.read.</p>
            }
        </section>
    }

    @if (editRole is not null)
    {
        <form @onsubmit="UpdateAsync" @onsubmit:preventDefault class="card card-body mb-3">
            <h2 class="h5">Editar rol</h2>
            <label for="edit-role-name" class="form-label">Nombre</label>
            <input id="edit-role-name" class="form-control mb-2" @bind="editName" required maxlength="64" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@isSaving">Guardar cambios</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancelar</button>
            </div>
        </form>
    }
}

@code {
    private readonly HashSet<string> capabilities = new(StringComparer.Ordinal);
    private List<RoleDto> roles = [];
    private RoleDto? selectedRole;
    private RoleDto? editRole;
    private RolePermissionsDto? rolePermissions;
    private string searchInput = "";
    private string search = "";
    private string createName = "";
    private string editName = "";
    private string? message;
    private int page = 1;
    private int totalCount;
    private const int PageSize = 10;
    private bool isLoading = true;
    private bool isSaving;
    private bool needsLogin;
    private bool accessDenied;
    private bool showCreate;
    private bool isCurrentAdmin;

    private int PageCount => Math.Max(1, (totalCount + PageSize - 1) / PageSize);
    private bool Can(string code) => capabilities.Contains(code);
    private bool CanReadRolePermissions => Can("roles.read") && Can("permissions.read");
    private bool CanManageRolePermissions => Can("roles.update") && Can("permissions.update");

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            using var permissions = await SendAsync(HttpMethod.Get, "api/security/capabilities");
            if (!permissions.IsSuccessStatusCode) { await HandleErrorAsync(permissions); return; }
            capabilities.Clear();
            foreach (var code in await permissions.Content.ReadFromJsonAsync<string[]>() ?? [])
            {
                capabilities.Add(code);
            }

            using var meResponse = await SendAsync(HttpMethod.Get, "api/auth/me");
            if (!meResponse.IsSuccessStatusCode) { await HandleErrorAsync(meResponse); return; }
            isCurrentAdmin = (await meResponse.Content.ReadFromJsonAsync<MeDto>())?.Roles
                .Contains("Admin", StringComparer.Ordinal) == true;

            using var response = await SendAsync(HttpMethod.Get,
                $"api/roles?page={page}&pageSize={PageSize}&search={Uri.EscapeDataString(search)}");
            if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response, readFailure: true); return; }
            var result = await response.Content.ReadFromJsonAsync<RolePageDto>();
            roles = result?.Items ?? [];
            totalCount = result?.TotalCount ?? 0;
            if (page > PageCount) { page = PageCount; await LoadAsync(); }
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            message = "No fue posible cargar los roles.";
        }
        finally { isLoading = false; }
    }

    private async Task SearchAsync()
    {
        search = searchInput.Trim();
        page = 1;
        selectedRole = null;
        rolePermissions = null;
        await LoadAsync();
    }
    private async Task PreviousPageAsync() { page--; await LoadAsync(); }
    private async Task NextPageAsync() { page++; await LoadAsync(); }
    private void ToggleCreate() => showCreate = !showCreate;
    private void BeginEdit(RoleDto role) { editRole = role; editName = role.Name; }
    private void CancelEdit() => editRole = null;

    private async Task ShowDetailsAsync(string id)
    {
        try
        {
            using var response = await SendAsync(HttpMethod.Get, $"api/roles/{Uri.EscapeDataString(id)}");
            if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response, readFailure: true); return; }
            selectedRole = await response.Content.ReadFromJsonAsync<RoleDto>();
            rolePermissions = null;
            if (selectedRole is not null && CanReadRolePermissions)
            {
                await LoadRolePermissionsAsync(selectedRole.Id);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            message = "No fue posible cargar el detalle del rol.";
        }
    }

    private async Task CreateAsync()
    {
        isSaving = true;
        try
        {
            using var response = await SendMutationAsync(HttpMethod.Post, "api/roles", new RoleRequest(createName));
            if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response); return; }
            createName = "";
            showCreate = false;
            await LoadAsync();
            message = "Rol creado sin permisos ni usuarios asignados.";
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            message = "No fue posible crear el rol.";
        }
        finally { isSaving = false; }
    }

    private async Task UpdateAsync()
    {
        if (editRole is null) return;
        isSaving = true;
        try
        {
            using var response = await SendMutationAsync(HttpMethod.Put,
                $"api/roles/{Uri.EscapeDataString(editRole.Id)}", new RoleRequest(editName));
            if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response); return; }
            selectedRole = await response.Content.ReadFromJsonAsync<RoleDto>();
            editRole = null;
            await LoadAsync();
            message = "Rol actualizado.";
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            message = "No fue posible actualizar el rol.";
        }
        finally { isSaving = false; }
    }

    private async Task DeleteAsync(RoleDto role)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el rol {role.Name}?")) return;
        isSaving = true;
        try
        {
            using var response = await SendMutationAsync(HttpMethod.Delete,
                $"api/roles/{Uri.EscapeDataString(role.Id)}", null);
            if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response); return; }
            if (selectedRole?.Id == role.Id) selectedRole = null;
            if (rolePermissions?.RoleId == role.Id) rolePermissions = null;
            if (editRole?.Id == role.Id) editRole = null;
            await LoadAsync();
            message = "Rol eliminado.";
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            message = "No fue posible eliminar el rol.";
        }
        finally { isSaving = false; }
    }

    private async Task LoadRolePermissionsAsync(string roleId)
    {
        using var response = await SendAsync(HttpMethod.Get,
            $"api/roles/{Uri.EscapeDataString(roleId)}/permissions");
        if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response); return; }
        rolePermissions = await response.Content.ReadFromJsonAsync<RolePermissionsDto>();
    }

    private async Task ChangePermissionAsync(RolePermissionDto permission)
    {
        if (selectedRole is null || permission.Locked || !isCurrentAdmin) return;
        isSaving = true;
        try
        {
            var method = permission.Assigned ? HttpMethod.Delete : HttpMethod.Post;
            using var response = await SendMutationAsync(method,
                $"api/roles/{Uri.EscapeDataString(selectedRole.Id)}/permissions/{permission.Id}", null);
            if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response); return; }
            rolePermissions = await response.Content.ReadFromJsonAsync<RolePermissionsDto>();
            message = permission.Assigned
                ? $"Permiso {permission.Code} revocado del rol."
                : $"Permiso {permission.Code} asignado al rol.";
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            message = "No fue posible cambiar la asignación de permiso.";
        }
        finally { isSaving = false; }
    }

    private async Task<HttpResponseMessage> SendMutationAsync(HttpMethod method, string path, object? body)
    {
        using var tokenResponse = await SendAsync(HttpMethod.Get, "api/security/antiforgery");
        if (!tokenResponse.IsSuccessStatusCode) return new HttpResponseMessage(tokenResponse.StatusCode);
        var token = (await tokenResponse.Content.ReadFromJsonAsync<TokenDto>())?.Token
            ?? throw new HttpRequestException("No se recibió el token antiforgery.");
        return await SendAsync(method, path, body, token);
    }

    private async Task<HttpResponseMessage> SendAsync(HttpMethod method, string path, object? body = null, string? token = null)
    {
        using var request = new HttpRequestMessage(method, path);
        request.SetBrowserRequestCredentials(BrowserRequestCredentials.SameOrigin);
        if (body is not null) request.Content = JsonContent.Create(body);
        if (token is not null) request.Headers.Add("X-CSRF-TOKEN", token);
        return await Http.SendAsync(request);
    }

    private async Task HandleErrorAsync(HttpResponseMessage response, bool readFailure = false)
    {
        if (response.StatusCode == HttpStatusCode.Unauthorized) { needsLogin = true; return; }
        if (response.StatusCode == HttpStatusCode.Forbidden)
        {
            if (readFailure) accessDenied = true;
            else message = "No tienes permiso para esta operación.";
            return;
        }
        if (response.StatusCode == HttpStatusCode.TooManyRequests)
        {
            message = RateLimitMessage(response);
            return;
        }

        var fallback = response.StatusCode switch
        {
            HttpStatusCode.BadRequest => "Datos inválidos o token antiforgery vencido.",
            HttpStatusCode.NotFound => "El rol ya no existe.",
            HttpStatusCode.Conflict => "La operación entra en conflicto con el estado del rol.",
            _ => "No fue posible completar la operación."
        };
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<ApiProblem>();
            message = problem?.Detail ?? problem?.Errors?.Values.SelectMany(values => values).FirstOrDefault()
                ?? problem?.Title ?? fallback;
        }
        catch (Exception exception) when (exception is JsonException or NotSupportedException)
        {
            message = fallback;
        }
    }

    private static string RateLimitMessage(HttpResponseMessage response)
    {
        var seconds = response.Headers.RetryAfter?.Delta?.TotalSeconds;
        return seconds is > 0
            ? $"Se alcanzó el límite de solicitudes. Reintenta en {Math.Ceiling(seconds.Value)} segundos."
            : "Se alcanzó el límite de solicitudes. Espera antes de reintentar.";
    }

    private sealed record RoleRequest(string Name);
    private sealed record RoleDto(string Id, string Name, bool IsProtected, int UserCount);
    private sealed record RolePageDto(List<RoleDto> Items, int Page, int PageSize, int TotalCount);
    private sealed record MeDto(string Id, string? Email, string[] Roles);
    private sealed record RolePermissionDto(
        int Id, string Code, string Name, string? Description, bool IsSystem, bool Assigned, bool Locked);
    private sealed record RolePermissionsDto(
        string RoleId, string RoleName, bool IsProtected, List<RolePermissionDto> Permissions);
    private sealed record TokenDto(string Token);
    private sealed record ApiProblem(string? Title, string? Detail, Dictionary<string, string[]>? Errors);
}
