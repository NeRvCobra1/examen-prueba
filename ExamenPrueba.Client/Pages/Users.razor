@page "/users"

@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@using Microsoft.JSInterop

@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Usuarios</PageTitle>
<h1>Usuarios</h1>

@if (needsLogin)
{
    <p role="alert">La sesión terminó. <a href="Account/Login?returnUrl=%2Fusers">Inicia sesión</a>.</p>
}
else if (accessDenied)
{
    <p role="alert">No tienes el permiso users.read.</p>
}
else
{
    @if (message is not null)
    {
        <p role="status">@message</p>
    }

    @if (isLoading)
    {
        <p>Cargando usuarios...</p>
    }
    else
    {
        <form @onsubmit="SearchAsync" @onsubmit:preventDefault class="row g-2 mb-3">
            <div class="col-sm-6">
                <label for="user-search" class="form-label">Buscar por correo</label>
                <input id="user-search" class="form-control" @bind="searchInput" maxlength="256" />
            </div>
            <div class="col-sm-auto align-self-end">
                <button type="submit" class="btn btn-outline-primary">Buscar</button>
            </div>
        </form>

        @if (Can("users.create"))
        {
            <button type="button" class="btn btn-primary mb-3" @onclick="ToggleCreate">Crear usuario</button>
            @if (showCreate)
            {
                <form @onsubmit="CreateAsync" @onsubmit:preventDefault class="card card-body mb-3">
                    <h2 class="h5">Nuevo usuario</h2>
                    <div class="mb-2">
                        <label for="create-email" class="form-label">Correo</label>
                        <input id="create-email" type="email" class="form-control" @bind="createEmail" required maxlength="256" autocomplete="off" />
                    </div>
                    <div class="mb-2">
                        <label for="create-password" class="form-label">Contraseña inicial</label>
                        <input id="create-password" type="password" class="form-control" @bind="createPassword" required autocomplete="new-password" />
                    </div>
                    <div class="mb-2">
                        <label for="create-confirm" class="form-label">Confirmar contraseña</label>
                        <input id="create-confirm" type="password" class="form-control" @bind="createConfirmPassword" required autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">Guardar</button>
                </form>
            }
        }

        <p>Total: @totalCount</p>
        <table class="table table-striped">
            <thead>
                <tr><th>Correo</th><th>Confirmado</th><th>Roles</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@(user.EmailConfirmed ? "Sí" : "No")</td>
                        <td>@string.Join(", ", user.Roles)</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ShowDetailsAsync(user.Id)">Detalle</button>
                            @if (Can("users.update"))
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => BeginEdit(user)">Editar</button>
                            }
                            @if (Can("users.delete"))
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(user)">Eliminar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex align-items-center gap-2 mb-3">
            <button type="button" class="btn btn-outline-secondary" disabled="@(page <= 1)" @onclick="PreviousPageAsync">Anterior</button>
            <span>Página @(page) de @PageCount</span>
            <button type="button" class="btn btn-outline-secondary" disabled="@(page >= PageCount)" @onclick="NextPageAsync">Siguiente</button>
        </div>

        @if (selectedUser is not null)
        {
            <section class="card card-body mb-3">
                <h2 class="h5">Detalle del usuario</h2>
                <p>Id: @selectedUser.Id</p>
                <p>Correo: @selectedUser.Email</p>
                <p>Confirmado: @(selectedUser.EmailConfirmed ? "Sí" : "No")</p>
                <p>Roles: @string.Join(", ", selectedUser.Roles)</p>
                @if (CanReadUserRoles)
                {
                    <h3 class="h6">Asignaciones Usuario–Rol</h3>
                    @if (userRoles is null)
                    {
                        <p>Cargando asignaciones...</p>
                    }
                    else
                    {
                        <ul class="list-group">
                            @foreach (var role in userRoles.Roles)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@role.Name — @(role.Assigned ? "Asignado" : "No asignado")@(role.IsProtected ? " (protegido)" : "")</span>
                                    @if (CanManageUserRoles && !(role.Name == "Admin" && selectedUser.Id == currentUserId))
                                    {
                                        @if (role.Assigned)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    disabled="@isSaving" @onclick="() => ChangeRoleAsync(role, false)">Revocar</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    disabled="@isSaving" @onclick="() => ChangeRoleAsync(role, true)">Asignar</button>
                                        }
                                    }
                                </li>
                            }
                        </ul>
                    }
                }
            </section>
        }

        @if (editUser is not null)
        {
            <form @onsubmit="UpdateAsync" @onsubmit:preventDefault class="card card-body mb-3">
                <h2 class="h5">Editar correo</h2>
                <p>Usuario: @editUser.Id</p>
                <label for="edit-email" class="form-label">Nuevo correo</label>
                <input id="edit-email" type="email" class="form-control mb-2" @bind="editEmail" required maxlength="256" />
                <p>Un correo nuevo debe confirmarse antes de usar la cuenta.</p>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">Guardar cambios</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancelar</button>
                </div>
            </form>
        }
    }
}

@code {
    private readonly HashSet<string> capabilities = new(StringComparer.Ordinal);
    private List<UserDto> users = [];
    private UserDto? selectedUser;
    private UserDto? editUser;
    private UserRolesDto? userRoles;
    private string? currentUserId;
    private string searchInput = "";
    private string search = "";
    private string createEmail = "";
    private string createPassword = "";
    private string createConfirmPassword = "";
    private string editEmail = "";
    private string? message;
    private int page = 1;
    private int totalCount;
    private const int PageSize = 10;
    private bool isLoading = true;
    private bool isSaving;
    private bool needsLogin;
    private bool accessDenied;
    private bool showCreate;

    private int PageCount => Math.Max(1, (totalCount + PageSize - 1) / PageSize);
    private bool Can(string code) => capabilities.Contains(code);
    private bool CanReadUserRoles => Can("users.read") && Can("roles.read");
    private bool CanManageUserRoles => Can("users.update") && Can("roles.update");

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            using var permissions = await SendAsync(HttpMethod.Get, "api/security/capabilities");
            if (!permissions.IsSuccessStatusCode)
            {
                await HandleErrorAsync(permissions);
                return;
            }

            capabilities.Clear();
            foreach (var code in await permissions.Content.ReadFromJsonAsync<string[]>() ?? [])
            {
                capabilities.Add(code);
            }

            if (currentUserId is null)
            {
                using var meResponse = await SendAsync(HttpMethod.Get, "api/auth/me");
                if (!meResponse.IsSuccessStatusCode) { await HandleErrorAsync(meResponse); return; }
                currentUserId = (await meResponse.Content.ReadFromJsonAsync<MeDto>())?.Id;
            }

            using var response = await SendAsync(HttpMethod.Get,
                $"api/users?page={page}&pageSize={PageSize}&search={Uri.EscapeDataString(search)}");
            if (!response.IsSuccessStatusCode)
            {
                await HandleErrorAsync(response, readFailure: true);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<UserPageDto>();
            users = result?.Items ?? [];
            totalCount = result?.TotalCount ?? 0;
            if (page > PageCount)
            {
                page = PageCount;
                await LoadAsync();
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            message = "No fue posible cargar usuarios.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        search = searchInput.Trim();
        page = 1;
        selectedUser = null;
        userRoles = null;
        await LoadAsync();
    }

    private async Task PreviousPageAsync() { page--; await LoadAsync(); }
    private async Task NextPageAsync() { page++; await LoadAsync(); }
    private void ToggleCreate() => showCreate = !showCreate;
    private void BeginEdit(UserDto user) { editUser = user; editEmail = user.Email ?? ""; }
    private void CancelEdit() => editUser = null;

    private async Task ShowDetailsAsync(string id)
    {
        try
        {
            using var response = await SendAsync(HttpMethod.Get, $"api/users/{Uri.EscapeDataString(id)}");
            if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response, readFailure: true); return; }
            selectedUser = await response.Content.ReadFromJsonAsync<UserDto>();
            userRoles = null;
            if (selectedUser is not null && CanReadUserRoles)
            {
                await LoadUserRolesAsync(selectedUser.Id);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            message = "No fue posible cargar el detalle.";
        }
    }

    private async Task CreateAsync()
    {
        isSaving = true;
        try
        {
            using var response = await SendMutationAsync(HttpMethod.Post, "api/users",
                new CreateUserRequest(createEmail, createPassword, createConfirmPassword));
            if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response); return; }
            var result = await response.Content.ReadFromJsonAsync<UserMutationDto>();
            createEmail = createPassword = createConfirmPassword = "";
            showCreate = false;
            await LoadAsync();
            message = "Usuario creado con rol User. Debe confirmar su correo." + Warning(result);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            message = "No fue posible crear el usuario.";
        }
        finally { isSaving = false; }
    }

    private async Task UpdateAsync()
    {
        if (editUser is null) return;
        isSaving = true;
        try
        {
            using var response = await SendMutationAsync(HttpMethod.Put,
                $"api/users/{Uri.EscapeDataString(editUser.Id)}", new UpdateUserRequest(editEmail));
            if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response); return; }
            var result = await response.Content.ReadFromJsonAsync<UserMutationDto>();
            editUser = null;
            selectedUser = result?.User;
            await LoadAsync();
            message = "Usuario actualizado. Si cambió el correo, debe confirmarse." + Warning(result);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            message = "No fue posible actualizar el usuario.";
        }
        finally { isSaving = false; }
    }

    private async Task DeleteAsync(UserDto user)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar definitivamente a {user.Email}?")) return;
        isSaving = true;
        try
        {
            using var response = await SendMutationAsync(HttpMethod.Delete,
                $"api/users/{Uri.EscapeDataString(user.Id)}", null);
            if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response); return; }
            if (selectedUser?.Id == user.Id) selectedUser = null;
            if (userRoles?.UserId == user.Id) userRoles = null;
            if (editUser?.Id == user.Id) editUser = null;
            await LoadAsync();
            message = "Usuario eliminado.";
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            message = "No fue posible eliminar el usuario.";
        }
        finally { isSaving = false; }
    }

    private async Task LoadUserRolesAsync(string userId)
    {
        using var response = await SendAsync(HttpMethod.Get,
            $"api/users/{Uri.EscapeDataString(userId)}/roles");
        if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response); return; }
        userRoles = await response.Content.ReadFromJsonAsync<UserRolesDto>();
    }

    private async Task ChangeRoleAsync(UserRoleDto role, bool assign)
    {
        if (selectedUser is null) return;
        isSaving = true;
        try
        {
            using var response = await SendMutationAsync(assign ? HttpMethod.Post : HttpMethod.Delete,
                $"api/users/{Uri.EscapeDataString(selectedUser.Id)}/roles/{Uri.EscapeDataString(role.Id)}", null);
            if (!response.IsSuccessStatusCode) { await HandleErrorAsync(response); return; }
            userRoles = await response.Content.ReadFromJsonAsync<UserRolesDto>();
            var assignedNames = userRoles?.Roles.Where(item => item.Assigned).Select(item => item.Name).ToArray() ?? [];
            selectedUser = selectedUser with { Roles = assignedNames };
            var index = users.FindIndex(user => user.Id == selectedUser.Id);
            if (index >= 0) users[index] = users[index] with { Roles = assignedNames };
            message = assign ? $"Rol {role.Name} asignado." : $"Rol {role.Name} revocado.";
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            message = "No fue posible cambiar la asignación de rol.";
        }
        finally { isSaving = false; }
    }

    private async Task<HttpResponseMessage> SendMutationAsync(HttpMethod method, string path, object? body)
    {
        using var tokenResponse = await SendAsync(HttpMethod.Get, "api/security/antiforgery");
        if (!tokenResponse.IsSuccessStatusCode)
        {
            return new HttpResponseMessage(tokenResponse.StatusCode);
        }

        var token = (await tokenResponse.Content.ReadFromJsonAsync<TokenDto>())?.Token
            ?? throw new HttpRequestException("No se recibió el token antiforgery.");
        return await SendAsync(method, path, body, token);
    }

    private async Task<HttpResponseMessage> SendAsync(HttpMethod method, string path, object? body = null, string? token = null)
    {
        using var request = new HttpRequestMessage(method, path);
        request.SetBrowserRequestCredentials(BrowserRequestCredentials.SameOrigin);
        if (body is not null) request.Content = JsonContent.Create(body);
        if (token is not null) request.Headers.Add("X-CSRF-TOKEN", token);
        return await Http.SendAsync(request);
    }

    private async Task HandleErrorAsync(HttpResponseMessage response, bool readFailure = false)
    {
        if (response.StatusCode == HttpStatusCode.Unauthorized)
        {
            needsLogin = true;
            return;
        }
        if (response.StatusCode == HttpStatusCode.Forbidden)
        {
            if (readFailure) accessDenied = true;
            else message = "No tienes permiso para esta operación.";
            return;
        }
        if (response.StatusCode == HttpStatusCode.TooManyRequests)
        {
            message = RateLimitMessage(response);
            return;
        }

        var defaultMessage = response.StatusCode switch
        {
            HttpStatusCode.BadRequest => "Datos inválidos o token antiforgery vencido.",
            HttpStatusCode.NotFound => "El usuario ya no existe.",
            HttpStatusCode.Conflict => "La operación entra en conflicto con los datos existentes.",
            _ => "No fue posible completar la operación."
        };
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<ApiProblem>();
            message = problem?.Detail ?? problem?.Errors?.Values.SelectMany(values => values).FirstOrDefault()
                ?? problem?.Title ?? defaultMessage;
        }
        catch (Exception exception) when (exception is JsonException or NotSupportedException)
        {
            message = defaultMessage;
        }
    }

    private static string RateLimitMessage(HttpResponseMessage response)
    {
        var seconds = response.Headers.RetryAfter?.Delta?.TotalSeconds;
        return seconds is > 0
            ? $"Se alcanzó el límite de solicitudes. Reintenta en {Math.Ceiling(seconds.Value)} segundos."
            : "Se alcanzó el límite de solicitudes. Espera antes de reintentar.";
    }

    private static string Warning(UserMutationDto? result) =>
        string.IsNullOrWhiteSpace(result?.Warning) ? "" : $" {result.Warning}";

    private sealed record CreateUserRequest(string Email, string Password, string ConfirmPassword);
    private sealed record UpdateUserRequest(string Email);
    private sealed record UserDto(string Id, string? Email, bool EmailConfirmed, string[] Roles);
    private sealed record UserPageDto(List<UserDto> Items, int Page, int PageSize, int TotalCount);
    private sealed record UserMutationDto(UserDto User, string? Warning);
    private sealed record MeDto(string Id);
    private sealed record UserRoleDto(string Id, string Name, bool IsProtected, bool Assigned);
    private sealed record UserRolesDto(string UserId, List<UserRoleDto> Roles);
    private sealed record TokenDto(string Token);
    private sealed record ApiProblem(string? Title, string? Detail, Dictionary<string, string[]>? Errors);
}
