{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=Data/app.db;Cache=Shared"
  },
  "Application": {
    "PublicOrigin": "https://localhost:7205"
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Registration": {
      "PermitLimit": 3,
      "WindowSeconds": 600
    },
    "AdministrativeRead": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "AdministrativeMutation": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
